#!/bin/sh
# S05nodeid — Initialize NodeID identity (built-in or module)
NODEID_FILE="/var/lib/sorabbyngo/nodeid"
PROC_NODEID="/proc/sorabbyngo/nodeid"
LOG="/var/log/sorabbyngo/nodeid.log"
mkdir -p /var/lib/sorabbyngo /var/log/sorabbyngo

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] nodeid: $*" | tee -a "$LOG"; }

case "$1" in
  start)
    log "Initializing NodeID..."

    # Try modprobe first (module case), ignore failure if built-in
    modprobe sorabbyngo_nodeid 2>/dev/null || true

    # Wait up to 3s for /proc entry
    for i in 1 2 3 4 5 6; do
        [ -f "$PROC_NODEID" ] && break
        sleep 0.5
    done

    if [ ! -f "$PROC_NODEID" ]; then
        log "FATAL: $PROC_NODEID not present — NodeID driver not loaded"
        exit 1
    fi

    CURRENT=$(cat "$PROC_NODEID" | tr -d '[:space:]')
    if [ -z "$CURRENT" ]; then
        log "FATAL: NodeID is empty"
        exit 1
    fi

    if [ ! -f "$NODEID_FILE" ]; then
        echo "$CURRENT" > "$NODEID_FILE"
        chmod 640 "$NODEID_FILE"
        log "NodeID sealed on first boot: ${CURRENT:0:16}..."
    else
        STORED=$(cat "$NODEID_FILE" | tr -d '[:space:]')
        if [ "$CURRENT" != "$STORED" ]; then
            log "FATAL: NodeID MISMATCH — hardware tampered"
            log "  stored:  ${STORED:0:16}..."
            log "  current: ${CURRENT:0:16}..."
            sync; halt -f 2>/dev/null || reboot -f
            exit 1
        fi
        log "NodeID verified: ${CURRENT:0:16}..."
    fi

    # Try to load Byngonet module (optional)
    modprobe byngonet 2>/dev/null && log "Byngonet loaded" || \
        log "WARN: byngonet not loaded (mesh disabled)"
    ;;
  stop)
    log "NodeID service stop"
    ;;
  status)
    [ -f "$PROC_NODEID" ] && echo "NodeID: $(cat $PROC_NODEID)" || echo "NodeID: not loaded"
    [ -f "$NODEID_FILE" ] && echo "Sealed: yes" || echo "Sealed: no"
    ;;
  *)
    echo "Usage: $0 {start|stop|status}"; exit 1 ;;
esac
