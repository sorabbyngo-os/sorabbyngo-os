{
  "defaultAction": "SCMP_ACT_ERRNO",
  "comment": "Seccomp profile for byngo-agent — tighter than base, no network socket creation",
  "syscalls": [
    {
      "names": [
        "read", "write", "open", "openat", "close", "stat", "fstat",
        "lstat", "newfstatat", "statx", "lseek", "mmap", "mprotect",
        "munmap", "brk", "rt_sigaction", "rt_sigprocmask", "rt_sigreturn",
        "pread64", "pwrite64", "readv", "writev", "access", "faccessat",
        "pipe", "pipe2", "select", "pselect6", "poll", "ppoll",
        "sched_yield", "mremap", "msync", "madvise",
        "dup", "dup2", "dup3", "nanosleep", "clock_nanosleep",
        "getpid", "gettid", "getppid", "getuid", "getgid",
        "geteuid", "getegid", "getgroups",
        "exit", "exit_group", "wait4", "waitid",
        "uname", "fcntl", "flock", "fsync",
        "truncate", "ftruncate", "getdents", "getdents64",
        "getcwd", "chdir", "rename", "renameat",
        "mkdir", "mkdirat", "rmdir", "unlink", "unlinkat",
        "symlink", "symlinkat", "readlink", "readlinkat",
        "chmod", "fchmod", "fchmodat",
        "gettimeofday", "clock_gettime", "clock_getres",
        "futex", "set_robust_list", "get_robust_list",
        "clone", "set_tid_address",
        "prctl", "arch_prctl",
        "getrandom", "memfd_create",
        "inotify_init", "inotify_init1",
        "inotify_add_watch", "inotify_rm_watch",
        "epoll_create", "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait",
        "eventfd", "eventfd2",
        "mlock", "munlock", "mlock2",
        "sendfile", "copy_file_range",
        "prlimit64", "getrlimit", "setrlimit",
        "sysinfo", "times",
        "io_uring_setup", "io_uring_enter", "io_uring_register"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Kill on dangerous syscalls",
      "names": [
        "ptrace", "kexec_load", "kexec_file_load",
        "create_module", "init_module", "finit_module", "delete_module",
        "iopl", "ioperm", "vm86", "vm86old"
      ],
      "action": "SCMP_ACT_KILL_PROCESS"
    }
  ]
}
